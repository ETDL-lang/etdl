etdl: "1.0.0"
info:
  title: "ECEL in/matches codegen check"
  version: "1.0.0"
  domain: "FulfillmentContext"
  description: "Minimal fixture exercising `in` and `matches`, the two ECEL comparators codegen lowers to etdl_core::condition helper calls rather than native Rust operators. Reuses the existing orders_api AsyncAPI import and message stubs (order-fulfillment.etdl / gencheck), so no new AsyncAPI schema or message-stub types are needed."

asyncapi_imports:
  orders_api: "./asyncapi/orders.yaml"

eventTrees:
  InMatchesCheck:
    initiatingEvent:
      id: OrderPlacedTrigger
      message: "orders_api#/components/messages/OrderPlaced"
      next: SkuBarrier

    nodes:
      SkuBarrier:
        type: barrier
        description: "`in` over a string array literal, then `matches` against a RE2 pattern, both against a string field reached through an array index path."
        branches:
          - outcome: KNOWN_SKU
            condition: 'message.payload.items[0].sku in ["SKU-1", "SKU-2"]'
            probability: 0.5
            next: DoneConsequence
          - outcome: SKU_PREFIX_MATCH
            condition: 'message.payload.items[0].sku matches "^SKU-[0-9]+$"'
            probability: 0.3
            next: DoneConsequence
          - outcome: OTHER
            condition: "default"
            probability: 0.2
            next: DoneConsequence

      DoneConsequence:
        type: consequence
        operation: terminate
