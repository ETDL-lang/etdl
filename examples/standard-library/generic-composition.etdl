# Example 1: generic event composition, no reliability involved.
#
# This document imports std.events and composes a generic readiness
# signal from its domain-neutral "generic identity" entries. Nothing here
# is about failure, fault, or hazard — std.events' generic identities
# carry no probability of their own until overridden, and this example
# deliberately avoids the reliability supplement entirely (no
# `supplements:` block) to prove it.
#
# std.logic is not used here: as of this version its content is a
# catalog of ready-to-use composite FAILURE gates (AnyNetworkFailure,
# AnyAuthFailure, ...) built from std.events' failure-mechanism entries —
# genuinely reusable as-is, but no longer domain-neutral, so it doesn't
# fit this specific demo. The boolean composition below is instead a
# small local gate, the same way any document already combines several
# basic events.

etdl: "1.0.0"
info:
  title: "Generic Readiness Composition"
  version: "1.0.0"
  domain: "DemoContext"

asyncapi_imports:
  api: "./api.yaml"

libraries:
  - name: std.events
    version: "1.0"

eventTrees:
  Readiness:
    initiatingEvent:
      id: CheckStarted
      message: "api#/components/messages/CheckRequested"
      next: Done
    nodes:
      Done:
        type: consequence
        operation: terminate

faultTrees:
  ReadinessComposition:
    topEvent:
      id: Top
      description: "at least one readiness signal is present"
      rootCause: G
    gates:
      G:
        type: OR
        description: "any one of three generic, domain-neutral occurrences"
        inputs:
          - "std.events.StateChanged"
          - "std.events.ConditionMet"
          - "std.events.SignalReceived"
    basicEvents:
      std.events.StateChanged:
        description: "a state changed (overriding std.events' generic identity with a local probability)"
        probability: 0.2
      std.events.ConditionMet:
        description: "a condition was met (overriding std.events' generic identity with a local probability)"
        probability: 0.15
      std.events.SignalReceived:
        description: "an external signal arrived (overriding std.events' generic identity with a local probability)"
        probability: 0.05
