etdl: "1.0.0"
info:
  title: "Inventory Reservation"
  version: "1.0.0"
  domain: "InventoryContext"
asyncapi_imports:
  api: "./asyncapi/common.yaml"
eventTrees:
  InventoryReservation:
    description: "Inventory Reservation."
    initiatingEvent:
      id: ReservationRequested
      message: "api#/components/messages/Event"
      next: StockCheck
    nodes:
      StockCheck:
        type: barrier
        branches:
          - outcome: SUCCESS
            condition: "message.payload.ok == true"
            probability: 0.97
            next: ReserveStockOperation
          - outcome: FAILURE
            condition: default
            probability: 0.03
            next: ReservationFailed
      ReserveStockOperation:
        type: operation
        action: execute
        handler: "reserve_stock_handler"
        emits: "api#/components/messages/Success"
        next: InventoryReservationSucceeded
        onFailure: ReservationFailed
        onFailureProbabilitySource: "#/faultTrees/ReservationFailure/topEvent"
        retryPolicy:
          maxAttempts: 3
          backoffMs: 250
          backoffStrategy: exponential
        timeoutMs: 5000
      InventoryReservationSucceeded:
        type: consequence
        operation: send
        channel: "api#/channels/OutcomeChannel"
        message: "api#/components/messages/Success"
      ReservationFailed:
        type: consequence
        operation: send
        channel: "api#/channels/DeadLetterChannel"
        message: "api#/components/messages/Failed"
faultTrees:
  ReservationFailure:
    description: "Inventory Reservation failure."
    topEvent:
      id: ReservationFailed
      description: "Inventory Reservation fails."
      rootCause: StockOrSystem
    gates:
      StockOrSystem:
        type: OR
        inputs:
          - StockUnavailable
          - SystemError
    basicEvents:
      StockUnavailable:
        description: "StockUnavailable."
        probability: 0.04
      SystemError:
        description: "SystemError."
        probability: 0.005
