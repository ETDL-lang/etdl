etdl: "1.0.0"
info:
  title: "Order Fulfillment"
  version: "1.0.0"
  domain: "FulfillmentContext"
asyncapi_imports:
  api: "./asyncapi/common.yaml"
eventTrees:
  OrderFulfillment:
    description: "Order Fulfillment."
    initiatingEvent:
      id: OrderPlaced
      message: "api#/components/messages/Event"
      next: InventoryCheck
    nodes:
      InventoryCheck:
        type: barrier
        branches:
          - outcome: SUCCESS
            condition: "message.payload.ok == true"
            probability: 0.97
            next: FulfillOrderOperation
          - outcome: FAILURE
            condition: default
            probability: 0.03
            next: FulfillmentFailed
      FulfillOrderOperation:
        type: operation
        action: execute
        handler: "fulfill_order_handler"
        emits: "api#/components/messages/Success"
        next: OrderFulfillmentSucceeded
        onFailure: FulfillmentFailed
        onFailureProbabilitySource: "#/faultTrees/FulfillmentFailure/topEvent"
        retryPolicy:
          maxAttempts: 3
          backoffMs: 250
          backoffStrategy: exponential
        timeoutMs: 5000
      OrderFulfillmentSucceeded:
        type: consequence
        operation: send
        channel: "api#/channels/OutcomeChannel"
        message: "api#/components/messages/Success"
      FulfillmentFailed:
        type: consequence
        operation: send
        channel: "api#/channels/DeadLetterChannel"
        message: "api#/components/messages/Failed"
faultTrees:
  FulfillmentFailure:
    description: "Order Fulfillment failure."
    topEvent:
      id: FulfillmentFailed
      description: "Order Fulfillment fails."
      rootCause: InventoryOrRouting
    gates:
      InventoryOrRouting:
        type: OR
        inputs:
          - InventoryOut
          - RoutingFailure
    basicEvents:
      InventoryOut:
        description: "InventoryOut."
        probability: 0.02
      RoutingFailure:
        description: "RoutingFailure."
        probability: 0.01
